import subprocess
import json
import os
import socket
import asyncio
from pathlib import Path
from textual.app import App, ComposeResult
from textual.containers import Horizontal, Vertical
from textual.widgets import Static, Input, ListView, ListItem, Label, ProgressBar

VERSION = "2.1"
HISTORY_FILE = Path.home() / ".tpvid_history.json"
MPV_SOCKET = "/tmp/tpvid_socket"

